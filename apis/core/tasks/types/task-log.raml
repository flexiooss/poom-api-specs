#%RAML 1.0 DataType
# defines task service types
#
# Usage : to be included in the types section as TaskLog: !include ...

type: object
properties:
  at: datetime-only
  log: string
  # detail of the log line, shown under it ; log stays the line label
  description: string
  level:
    enum: [ ERROR, WARN, INFO ]
  task-id: string