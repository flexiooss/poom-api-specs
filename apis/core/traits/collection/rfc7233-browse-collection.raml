#%RAML 1.0 Trait
### to be included in the traits section as rfc7233Browsing

usage: used for a GET over an collection resource
description: |
    RFC 7233 paged collection of <<entityType>>.
    Filtering and ordering are optional features.
  
    SINCE / BEFORE / LATEST / OLDEST:
    Une valeur que le service peut interpréter comme la valeur d'un critère d'ordre absolu et immutable.
    
    La réponse est paginée et ordonnée.
    SINCE : ordonnés du plus ancien au plus récent
    BEFORE : ordonnés du plus récent au plus ancien
    
    Dans le cas où SINCE et BEFORE sont spécifiés, le BEFORE devient un filtre, les résultats sont ordonnées comme un SINCE seul.
  
    init-ordered:LATEST renvoie les derniers éléments avec un since et un before correspondant
    init-ordered:OLDEST renvoie les premiers éléments avec un since correspondant
headers:
  range:
    type: string
    required: false
  since:
    description: |
      see description
    type: string
    required: false
  before:
    description: |
      see description
    type: string
    required: false
  init-ordered:
    description: |
      LATEST | OLDEST
      see description
    type: string
    required: false
queryParameters:
  filter:
     type: string
     description: |
        Conforms to PropertyFilter grammar from poom-services-org.codingmatters.poom.generic.resource.domain.
        Dotted properties are supported for nested objects.
        Supported properties are left to the implementation.
  order-by:
     type: string
     description: |
        Confirms to PropertySort grammar from poom-services-org.codingmatters.poom.generic.resource.domain.
        Dotted properties are supported for nested objects.
        Supported properties are left to the implementation.
  resolved-properties:
     type: string

responses:
  200:
    description: |
      complete list or last entities of the collection
    headers:
      Content-Range: string
      Accept-Range: string
      Cache-Control: string
      x-entity-type: string
      since: string
      before: string
    body: <<entityType>>[]
  206:
    description: |
      partial list of entities of the collection
    headers:
      Content-Range: string
      Accept-Range: string
      Cache-Control: string
      x-entity-type: string
      since: string
      before: string
    body: <<entityType>>[]
  416:
    description: |
      the specified range is not acceptable (Error code is ILLEGAL_RANGE_SPEC).
    headers:
      Content-Range: string
      Accept-Range: string
    body: <<error>>
  400:
    description: |
      the query is not acceptable (Error code is ILLEGAL_REQUEST).
    body: <<error>>
  401:
    description: |
      Paged resource access denied. Code BAD_REQUEST.
    body: <<error>>
  403:
    description: |
      Paged resource access denied. Code BAD_REQUEST.
    body: <<error>>
  404:
    description: |
      No paged resource found. Code RESOURCE_NOT_FOUND.
    body: <<error>>
  405:
    body: <<error>>
  500:
    description: UNEXPECTED_ERROR.
    body: <<error>>